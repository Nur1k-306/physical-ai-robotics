# CPU-образ: Ubuntu + PyTorch CPU + JAX CPU + MuJoCo Playground (без NVIDIA).
# Сборка и запуск: ./scripts/run_container.sh (на хосте без GPU выбирается автоматически)
# или явно: ./scripts/run_container.sh --cpu
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    xvfb \
    x11vnc \
    x11-xserver-utils \
    fluxbox \
    novnc \
    python3-websockify \
    python3 \
    python3-pip \
    libgl1-mesa-glx \
    libgl1-mesa-dev \
    libglu1-mesa \
    libglu1-mesa-dev \
    libosmesa6-dev \
    libglew-dev \
    libglfw3 \
    libglfw3-dev \
    libegl1-mesa-dev \
    wget \
    curl \
    net-tools \
    supervisor \
    git \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir \
    torch==2.6.0 --index-url https://download.pytorch.org/whl/cpu

COPY docs/cpu-constraints.txt /tmp/cpu-constraints.txt

RUN --mount=type=bind,from=wheels,target=/wheels pip3 install --no-cache-dir --find-links=/wheels -c /tmp/cpu-constraints.txt \
    "playground[learning]==0.1.0"

RUN --mount=type=bind,from=wheels,target=/wheels pip3 install --no-cache-dir --find-links=/wheels -c /tmp/cpu-constraints.txt \
    jax==0.6.2 \
    jaxlib==0.6.2

RUN --mount=type=bind,from=wheels,target=/wheels pip3 install --no-cache-dir --find-links=/wheels -c /tmp/cpu-constraints.txt \
    mujoco==3.5.0 \
    mujoco-mjx==3.5.0 \
    gymnasium[mujoco]==1.3.0 \
    numpy==2.2.6 \
    imageio[ffmpeg]==2.37.3 \
    pytest==9.1.1 \
    tensorboard==2.21.0

ENV DISPLAY=:99
ENV MUJOCO_GL=glx
ENV MUJOCO_PLAYGROUND_CPU_MJX_IMPL=jax

COPY environment/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

WORKDIR /workspace

EXPOSE 5900 6080

CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]

# Preload only the official robot assets used by PandaPickCube, at Playground's pinned commit.
# Other robot tasks can be added later with git sparse-checkout add <robot-directory>.
RUN set -eu; \
    assets=/usr/local/lib/python3.10/dist-packages/mujoco_playground/external_deps/mujoco_menagerie; \
    mkdir -p "$assets"; cd "$assets"; \
    git init; \
    git remote add origin https://github.com/deepmind/mujoco_menagerie.git; \
    git sparse-checkout init --cone; \
    git sparse-checkout set franka_emika_panda; \
    git fetch --depth=1 --filter=blob:none origin 1b86ece576591213e2b666ebf59508454200ca97; \
    git checkout --detach 1b86ece576591213e2b666ebf59508454200ca97
